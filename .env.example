# Copy this file to .env and fill it in. `npm run dev` and `npm start` read .env.
# The settings screen will replace this later.

# openai, anthropic, gemini or ollama
MOCKROOM_PROVIDER=anthropic

# Optional, except for Ollama. Defaults: gpt-5.4-mini, claude-haiku-5-5, gemini-flash-latest
# MOCKROOM_MODEL=

# The key for your provider (Ollama needs none)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Where Ollama runs, if not on this machine's default port
# MOCKROOM_OLLAMA_URL=http://127.0.0.1:11434
