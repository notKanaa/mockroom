{
  "name": "mockroom",
  "version": "0.0.0",
  "description": "Open-source AI technical interview simulator that runs on your machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notKanaa/mockroom.git"
  },
  "type": "module",
  "bin": {
    "mockroom": "dist/server/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,ui --prefix-colors blue,magenta \"node --watch --import tsx src/server/dev.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
